# PLANTILLA: este archivo SÍ se sube a GitHub. NO pongas claves aquí.
# Cópialo como .env (git lo ignora) y llena los valores en ese .env.
# Cloudflare R2 → R2 Object Storage → Manage API tokens → Account API token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fr-scraper-datos

# Opcional, para probar el envío de la alerta desde tu equipo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcional, para probar el monitor (src/monitor.py): tu chat, solo para mensajes técnicos
TELEGRAM_ADMIN_CHAT_ID=
